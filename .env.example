DATABASE_URL=
# Optional path to the Supabase CA certificate for TLS verification.
# NIHON_DATABASE_CA_FILE=
# For hosted deployments, set NIHON_DATABASE_CA_PEM to the multiline Supabase CA certificate.
# NIHON_DATABASE_CA_PEM=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Enable this for local signup, verification and password reset links.
NIHON_DEV_EMAIL_LINKS=1
# For deployment, use 0 above and configure a verified Resend sender.
RESEND_API_KEY=
NIHON_EMAIL_FROM=
# Public origin for verification and reset emails. Vercel production can use its project domain by default.
# NIHON_ORIGIN=https://study.example.com
